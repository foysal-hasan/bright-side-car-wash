# -----------------------------------------------
# Application
# -----------------------------------------------
APP_NAME=
APP_KEY=
APP_URL=
CLIENT_APP_URL=
NODE_ENV=development
PORT=4000
CROSS_ORIGINS=http://localhost:3000,http://localhost:4000

# -----------------------------------------------
# Swagger
# -----------------------------------------------
ENABLE_SWAGGER=true
SWAGGER_USER=admin
SWAGGER_PASSWORD=your-strong-password-here


# -----------------------------------------------
# Database
# -----------------------------------------------
DATABASE_URL=

# -----------------------------------------------
# Redis
# -----------------------------------------------
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------
# JWT
# -----------------------------------------------
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_SECRET=
JWT_REFRESH_TOKEN_EXPIRY=7d

# -----------------------------------------------
# Mail
# -----------------------------------------------
MAIL_PROVIDER=brevo
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_SENDER_NAME=
MAIL_SENDER_EMAIL=

# -----------------------------------------------
# File Storage  (local | s3 | gcs)
# -----------------------------------------------
FILE_STORAGE=local

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=

# Google Cloud Storage
GCP_PROJECT_ID=
GCP_KEY_FILE=
GCP_API_ENDPOINT=
GCP_BUCKET=

# -----------------------------------------------
# Payment — Stripe
# -----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------
# Payment — PayPal
# -----------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_API=

# -----------------------------------------------
# Payment — Square
# -----------------------------------------------
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LIMIT=100

# -----------------------------------------------
# Campaign — Brevo
# -----------------------------------------------
BREVO_API_KEY=
BREVO_SENDER_NAME=
BREVO_SENDER_EMAIL=

# -----------------------------------------------
# Stripe Onboarding URLs
# -----------------------------------------------
ONBOARDING_REFRESH_URL=
ONBOARDING_RETURN_URL=

# -----------------------------------------------
# Default Users (seeded on first boot)
# -----------------------------------------------
SYSTEM_USERNAME=
SYSTEM_EMAIL=
SYSTEM_PASSWORD=

SUPERUSER_NAME=
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=
